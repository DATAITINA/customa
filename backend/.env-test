# Backend
SERVER_NAME=localhost
SERVER_HOST=https://${SERVER_NAME}
BACKEND_CORS_ORIGINS=["*"]
PROJECT_NAME="Project Backend"
SECRET_KEY=ABCDEFGHIJLKALSKAFJS12981C1MC912C21C9N182NC1982C1C1N1NC
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=xxxxxxxxxxxx

# Frontend
CLIENT_NAME=localhost
CLIENT_HOST=https://${CLIENT_NAME}
PASSWORD_RESET_PATH=/reset-password

# SMTP
SMTP_TLS=True
SMTP_PORT=465
SMTP_HOST=mail.example.org
SMTP_USER=admin@example.org
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAILS_FROM_EMAIL=admin@example.org

EMAILS_USE_SENDMAIL=False

USERS_OPEN_REGISTRATION=True
ALLOW_WORKSPACE_REGISTRATION=True

# Sentry
SENTRY_DSN=https://1234567890987654321.sentry.io

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=testdb

# Use sqlite (this overrides postgres)
USE_SQLITE=True
SQLITE_DATABASE_URI=sqlite:///./test.db

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Initial data seed
INITIAL_DATA_RESET_DB=True

# File storage
STORAGE_METHOD=file
STORAGE_PATH=uploads
STORAGE_BASE_URL=/uploads

# Discord Integration
BOT_TOKEN=

# SMS with Twilio
